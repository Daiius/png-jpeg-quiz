# 雛形。`cp .env.example .env` して**ローカルの値**を入れる。
# 🔒 .env の実体はコミットしない（.gitignore 済み）。本番/開発の具体値もここには書かない。

# --- 開発サーバ ---
# ホスト側のポート（3000 が埋まっていたら変える）
WEB_PORT=3000
# 絶対 URL の生成に使う（OGP など）
PUBLIC_ORIGIN=http://localhost:3000

# --- MySQL（compose 網内。ホストにはポートを出さない）---
MYSQL_DATABASE=png_jpeg_quiz
MYSQL_USER=quiz
# ⚠ ローカル専用の値に置き換える
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# compose の web が組み立てるので、compose 経由なら設定不要。
# ホストから直接 pnpm を叩くときだけ使う（その場合 db をホストに露出する必要がある）
# DATABASE_URL=mysql://quiz:change-me@127.0.0.1:3306/png_jpeg_quiz

# --- 画像配信（M4 で R2 のカスタムドメインに差し替える。prd/02 §5）---
ASSET_BASE_URL=http://localhost:3000/assets

# --- Cloudflare R2（M4。認証情報は絶対にコミットしない）---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
