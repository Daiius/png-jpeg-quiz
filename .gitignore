# dependencies
node_modules/
.pnpm-store/

# build artifacts
dist/
build/
*.tsbuildinfo
.next/
next-env.d.ts

# test / coverage
coverage/
# Playwright（E2E）の実行生成物
test-results/
playwright-report/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# env / secrets（公開リポなので本番/開発の具体値は絶対にコミットしない）
.env
.env.*
# 雛形（.env.example / .env.<name>.example）だけは追跡する
!.env.example
!.env.*.example

# ローカル専用のエージェント向けルール/情報（gitignore。存在すれば AGENTS.md から参照）
.claude/local/

# Playwright MCP のスクショ出力（グローバル gitignore 対象だが念のため）
.playwright-mcp/

# クイズのビルド成果物（エンコード済みアセット。prd/05 §2。Q8 で扱いを決める）
/build/
/assets/generated/

# DB バックアップ（pnpm db:backup の出力。コミットしない）
backups/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
