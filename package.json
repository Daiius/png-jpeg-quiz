{
  "name": "png-jpeg-quiz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "docker compose up --watch --build",
    "dev:logs": "docker compose logs -f",
    "dev:down": "docker compose down",
    "dev:remote": "docker compose --env-file .env --env-file .env.remote up --watch --build",
    "dev:remote:logs": "docker compose --env-file .env --env-file .env.remote logs -f",
    "dev:remote:down": "docker compose --env-file .env --env-file .env.remote down",
    "typecheck": "pnpm -r --no-bail typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @png-jpeg-quiz/web test:e2e",
    "db:backup": "bash scripts/db-backup.sh",
    "db:generate": "pnpm --filter @png-jpeg-quiz/database generate",
    "db:migrate": "pnpm --filter @png-jpeg-quiz/database migrate",
    "db:seed": "pnpm --filter @png-jpeg-quiz/database seed",
    "quiz:build": "pnpm --filter @png-jpeg-quiz/pipeline build",
    "quiz:recalc": "pnpm --filter @png-jpeg-quiz/pipeline recalc",
    "quiz:upload": "pnpm --filter @png-jpeg-quiz/pipeline upload",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
